{
  "name": "unipro-pos-counter",
  "version": "1.0.0",
  "description": "UniPro Hybrid POS Counter PC - Integrated Cashier POS Terminal, Dual Monitor Customer Display & LAN Print Bridge",
  "author": "UniPro",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['dist','customer-display-web'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "tsc && xcopy /E /I /Y src\\public dist\\public",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "build": {
    "appId": "com.unipro.poscounter",
    "productName": "Smart-Club POS UniPro",
    "directories": {
      "output": "C:/unipro_build_output"
    },
    "files": [
      "dist/**/*",
      "customer-display-web/**/*",
      "config.json"
    ],
    "extraResources": [
      {
        "from": "customer-display-web",
        "to": "customer-display-web"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/node_modules/.cache/**",
          "!**/*.log",
          "!error_log.txt",
          "!**/scratch/**",
          "!**/scripts/**",
          "!check_schema.js",
          "!diagnose_rewards.js",
          "!migrate_reward_details.js"
        ]
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart-Club POS UniPro"
    }
  }
}
